{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "tray"],
  "permissions": [
    "autostart:default",
    "core:default",
    "core:window:allow-start-dragging",
    "notifications:default",
    "shell:default",
    "store:default",
    "window-state:default"
  ]
}
